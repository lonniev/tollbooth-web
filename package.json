{
  "name": "@tollbooth-dpyc/web",
  "version": "3.12.0",
  "description": "Shared browser SDK for Tollbooth DPYC operator front ends: npub sign-in, proofs, MCP client, profile and wallet",
  "license": "Apache-2.0",
  "author": "Lonnie VanZandt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lonniev/tollbooth-web.git"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./pages-proxy": {
      "types": "./dist/pagesProxy.d.ts",
      "default": "./dist/pagesProxy.js"
    },
    "./agent-guide": {
      "types": "./dist/agentGuide.d.ts",
      "default": "./dist/agentGuide.js"
    },
    "./markdown": {
      "types": "./dist/markdown/index.d.ts",
      "default": "./dist/markdown/index.js"
    },
    "./theme.css": "./theme.css",
    "./tour.css": "./tour.css",
    "./price-sheet.css": "./price-sheet.css",
    "./wallet.css": "./wallet.css",
    "./markdown.css": "./markdown.css"
  },
  "files": [
    "dist",
    "theme.css",
    "tour.css",
    "price-sheet.css",
    "wallet.css",
    "markdown.css",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test 'src/**/*.test.ts'",
    "prepublishOnly": "npm test && npm run build"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "lucide-react": ">=1.0.0",
    "nostr-tools": "^2.23.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "lucide-react": "^1.47.0",
    "nostr-tools": "^2.25.2",
    "react": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@noble/curves": "2.0.1",
    "@noble/hashes": "2.0.1",
    "driver.js": "1.12.1",
    "i18next": "27.1.2",
    "qrcode-generator": "2.0.4",
    "react-i18next": "18.0.1",
    "react-markdown": "10.1.0",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1"
  }
}
